{
  "name": "relayplan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "video:studio": "remotion studio video/index.tsx --no-open",
    "video:render": "remotion render video/index.tsx RelayPlan video/out/RelayPlan-1080p.mp4",
    "video:thumbnail": "remotion still video/index.tsx Thumbnail video/out/thumbnail.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "@remotion/media": "4.0.534",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.534",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
